cd# MongoDB connection string
# Option 1: Local MongoDB (default)
MONGO_URI=mongodb://localhost:27017/company-password-vault

# Option 2: MongoDB Atlas (uncomment and replace with your connection string)
# MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/company-password-vault?retryWrites=true&w=majority

# JWT secret key for authentication
JWT_SECRET="protocol-451/.rte"

# Server port
PORT=5000

